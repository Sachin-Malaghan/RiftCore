# Simple Pillar/Column Model
# Good for testing UV mapping

mtllib pillar.mtl

# Bottom base vertices
v -0.5  0.0 -0.5
v  0.5  0.0 -0.5
v  0.5  0.0  0.5
v -0.5  0.0  0.5

# Column vertices (narrower)
v -0.3  0.3 -0.3
v  0.3  0.3 -0.3
v  0.3  0.3  0.3
v -0.3  0.3  0.3

v -0.3  2.7 -0.3
v  0.3  2.7 -0.3
v  0.3  2.7  0.3
v -0.3  2.7  0.3

# Top cap vertices
v -0.5  3.0 -0.5
v  0.5  3.0 -0.5
v  0.5  3.0  0.5
v -0.5  3.0  0.5

# UVs
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vt 0.25 0.1
vt 0.75 0.1
vt 0.75 0.9
vt 0.25 0.9

# Normals
vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0
vn  1.0  0.0  0.0
vn -1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0

usemtl stone

# Base - bottom
f 1/1/6 4/4/6 3/3/6
f 1/1/6 3/3/6 2/2/6

# Base - top
f 5/1/5 6/2/5 7/3/5
f 5/1/5 7/3/5 8/4/5

# Base sides
f 1/1/2 2/2/2 6/3/2
f 1/1/2 6/3/2 5/4/2

f 2/1/3 3/2/3 7/3/3
f 2/1/3 7/3/3 6/4/3

f 3/2/1 4/1/1 8/4/1
f 3/2/1 8/4/1 7/3/1

f 4/2/4 1/1/4 5/4/4
f 4/2/4 5/4/4 8/3/4

# Column sides
f 5/5/2 6/6/2 10/7/2
f 5/5/2 10/7/2 9/8/2

f 6/5/3 7/6/3 11/7/3
f 6/5/3 11/7/3 10/8/3

f 7/6/1 8/5/1 12/8/1
f 7/6/1 12/8/1 11/7/1

f 8/6/4 5/5/4 9/8/4
f 8/6/4 9/8/4 12/7/4

# Top cap - bottom
f 9/8/6  12/7/6 11/6/6
f 9/8/6  11/6/6 10/5/6

# Top cap - top
f 13/1/5 14/2/5 15/3/5
f 13/1/5 15/3/5 16/4/5

# Top cap sides
f 9/1/2  10/2/2 14/3/2
f 9/1/2  14/3/2 13/4/2

f 10/1/3 11/2/3 15/3/3
f 10/1/3 15/3/3 14/4/3

f 11/2/1 12/1/1 16/4/1
f 11/2/1 16/4/1 15/3/1

